// The SPA is packed into a Worker by tools/build-worker.mjs (see npm run deploy:staging).
// Production: build with .env.production, then `npx wrangler deploy --name reidle`.
{
  "name": "reidle-staging",
  "main": ".worker/index.js",
  "compatibility_date": "2026-10-01",
  // Workers Logs: every request (and any console output) is kept and searchable in the dashboard
  // (Workers & Pages -> the worker -> Logs). Applies to staging and prod (deploy --name reidle uses this file).
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
