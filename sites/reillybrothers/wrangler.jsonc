// reillybrothers.net: a tiny static home page (Google sign-in branding lists it as the home page); /privacy and
// /tos redirect to the copies Reidle serves (public/privacy.html, public/tos.html).
// Deployed by .github/workflows/deploy-reillybrothers.yml; the custom domain makes Cloudflare add the apex DNS record.
{
  "name": "reillybrothers",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./public", "html_handling": "drop-trailing-slash" },
  "routes": [{ "pattern": "reillybrothers.net", "custom_domain": true }]
}
